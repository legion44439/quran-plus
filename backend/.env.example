# Server
PORT=4000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://quran:quran_secret@localhost:5432/quran_plus?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seeded superadmin (created by prisma db seed)
SUPERADMIN_EMAIL=admin@quranplus.local
SUPERADMIN_PASSWORD=Admin123!

# Cloudflare R2 (media)
R2_ACCOUNT_ID=
R2_ACCOUNT_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quran-plus-media
